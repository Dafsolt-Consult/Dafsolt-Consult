# Android TWA — the entire Gradle project (app/, gradlew, build.gradle,
# the .aab/.apk build output) is generated by `bubblewrap update`/`build`
# from twa-manifest.json, so only that source-of-truth file and the
# generated assetlinks.json are worth committing. The upload keystore is a
# secret and must never be committed either way.
android-twa/*
!android-twa/twa-manifest.json
!android-twa/assetlinks.json
!android-twa/store-listing/

play-deploy/.env
play-deploy/service-account.json
play-deploy/node_modules/
