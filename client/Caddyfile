http://{$DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy server:4000
	}

	handle /health {
		reverse_proxy server:4000
	}

	handle /uploads/* {
		reverse_proxy server:4000
	}

	# Vite content-hashes these filenames, so a given URL's content never
	# changes — safe to cache forever. index.html references the current
	# hash, so a new deploy always gets a new URL here.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# PWA icons aren't content-hashed like /assets/*, so a short cache
	# (not "immutable") — fast on repeat installs/home-screen loads, but a
	# future icon redesign still shows up within a week without a rename.
	handle /icons/* {
		root * /srv
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# Digital Asset Links verification for the Android TWA — must be served
	# as real JSON, never caught by the SPA fallback below (a browser/Play
	# fetching this and getting index.html back means the app opens with
	# browser chrome instead of as a standalone app).
	handle /.well-known/* {
		root * /srv
		header Cache-Control "no-cache"
		file_server
	}

	# The SPA shell itself must never be served stale, or the browser can
	# keep pointing at pre-deploy asset hashes indefinitely (no explicit
	# Cache-Control here previously meant browsers fell back to heuristic
	# caching instead of always revalidating).
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
