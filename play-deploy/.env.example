# Copy to .env (gitignored) and fill in real values.

# Path to the Play Console service-account JSON key (Setup > API access >
# create/link a service account, grant it "Release manager" or a custom
# role with release access under Users and permissions).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# The app's package name — must already exist in Play Console (Google
# requires the very first app-shell creation + first release to go through
# the Console UI manually; this script only handles subsequent uploads).
ANDROID_PACKAGE_NAME=cloud.dafsolt.school

# Path to the signed .aab to upload, relative to this directory.
AAB_PATH=../android-twa/app-release-bundle.aab

# Which testing track to upload to. Deliberately defaults to internal —
# promoting to production is a separate, explicit step never done by this
# script.
TRACK=internal
