# Copy this file to `.env` (same directory as docker-compose.prod.yml) and
# fill in real values before running:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Generate strong secrets with:  openssl rand -base64 48

# ── Domain ────────────────────────────────────────────────────────────────
# Must already point (DNS A record) at this VPS's public IP before you start
# the stack, or Caddy will fail to obtain a Let's Encrypt certificate.
DOMAIN=school.yourdomain.com

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=dafsolt_prod
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=dafsolt_school

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand--base64-48
JWT_REFRESH_SECRET=change-me-generate-a-different-one

# ── Platform super admin (seeded on first boot via /api/auth — see README) ─
SUPER_ADMIN_EMAIL=platform@yourdomain.com
SUPER_ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Email (SMTP) — optional ─────────────────────────────────────────────────
# Leave SMTP_HOST blank to fall back to server-log delivery for password
# resets (see DEPLOYMENT.md § 6). Once set, every notification (assignments,
# invoices, report cards, announcements, password resets) is also emailed to
# recipients automatically — any standard SMTP provider works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=School Manager <no-reply@yourdomain.com>
