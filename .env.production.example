# Copy this file to `.env` (same directory as docker-compose.prod.yml) and
# fill in real values before running:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Generate strong secrets with:  openssl rand -base64 48

# ── Domain ────────────────────────────────────────────────────────────────
# Must already point (DNS A record) at this VPS's public IP before you start
# the stack, or Caddy will fail to obtain a Let's Encrypt certificate.
DOMAIN=school.yourdomain.com

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=dafsolt_prod
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=dafsolt_school

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand--base64-48
JWT_REFRESH_SECRET=change-me-generate-a-different-one
# Separate secret for platform-admin tokens — must differ from both above.
JWT_PLATFORM_SECRET=change-me-generate-a-third-one
# Separate secret for the CBT exam-hall kiosk login (name + admission
# number, supervised in-person — see server/src/utils/kioskJwt.ts) — must
# differ from all three above.
JWT_KIOSK_SECRET=change-me-generate-a-fourth-one
# Optional — kiosk session length, default 4h (one supervised sitting).
JWT_KIOSK_TTL=4h

# ── First platform admin (role OWNER), seeded on first boot — see
# server/src/bootstrap.ts. Required: the server refuses to start without
# JWT_PLATFORM_SECRET, and silently skips bootstrap (logging a warning) if
# these two are left blank rather than falling back to a default password.
SUPER_ADMIN_EMAIL=platform@yourdomain.com
SUPER_ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Email (SMTP) — optional, leave blank to keep delivery in-app-only ──────
# Used for password reset emails and emergency broadcasts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="School Manager <no-reply@yourdomain.com>"

# ── SMS (Africa's Talking) — optional, leave blank to keep delivery in-app-only ─
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
