# Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://dafsolt:dafsolt@localhost:5432/dafsolt_school?schema=public"

# Auth
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
# Separate secret for platform-admin tokens (src/utils/platformJwt.ts) — must
# differ from the two above.
JWT_PLATFORM_SECRET=change-this-platform-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# First platform admin (role OWNER), created automatically on server startup
# only if the platform_admins table is empty — see src/bootstrap.ts. There is
# no default password: if either var is unset, bootstrap skips and logs a
# warning instead of creating an account with a guessable password.
SUPER_ADMIN_EMAIL=platform@dafsolt.com
SUPER_ADMIN_PASSWORD=

# African payment gateways (stubs - fill in when integrating)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# SMS (Africa's Talking) - fill in to enable real SMS delivery
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Email (SMTP) - fill in to enable real email delivery (password resets,
# emergency broadcasts). Leave blank to keep delivery in-app-only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="School Manager <no-reply@dafsolt.com>"

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# dafsolt.cloud backoffice's cross-product Monitor page. Unset in
# local/staging — the scheduler's report job silently no-ops without both.
MONITOR_REPORT_URL=https://dafsolt.cloud/api/monitor-report.php?product=edu
MONITOR_REPORT_TOKEN=
