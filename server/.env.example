# Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://dafsolt:dafsolt@localhost:5432/dafsolt_school?schema=public"

# Auth
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Platform super admin (created automatically on server startup if this
# email doesn't already exist — see src/bootstrap.ts)
SUPER_ADMIN_EMAIL=platform@dafsolt.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# African payment gateways (stubs - fill in when integrating)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# SMS (Africa's Talking) - stub
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Email (SMTP) - password resets and all in-app notifications (assignments,
# invoices, report cards, announcements) are emailed to recipients when this
# is configured. Leave SMTP_HOST blank to fall back to server-log delivery
# (see DEPLOYMENT.md). Any standard SMTP provider works - Gmail, Zoho,
# SendGrid/Mailgun's SMTP relay, your host's mail server, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="School Manager <no-reply@yourdomain.com>"

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
